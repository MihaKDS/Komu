generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Media {
  id                  Int      @id @default(autoincrement())
  title               String
  author              String?
  description         String?
  releaseYear         Int?
  poster              String?
  category            Category
  tmdbId              Int?     @unique

  // Optional link to a mediaCollection
  mediaCollectionId   Int?
  collectionPosition  Int?
  mediaCollection     MediaCollection? @relation(fields: [mediaCollectionId], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  copies              Copy[]
}

model MediaCollection {
  id        Int      @id @default(autoincrement())
  tmdbId    Int?     @unique
  title     String
  overview  String?
  poster    String?
  category  Category

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medias    Media[]
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String
  city         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  copies       Copy[]
  tradesAsBuyer Trade[] @relation("TradeBuyer")
  tradesAsSeller Trade[] @relation("TradeSeller")
  tradeMessages TradeMessage[]
}

model BoxSet {
  id          Int      @id @default(autoincrement())
  title       String?
  name        String?
  listingNote String?

  canSell     Boolean  @default(false)
  sellPrice   Float?
  buyBack     Boolean   @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  copies      Copy[]
}

model Copy {
  id             Int       @id @default(autoincrement())
  mediaId        Int
  userId         Int

  edition        Edition
  title          String?
  includesBluRay Boolean   @default(false)
  listingNote    String?
  boxSetId       Int?
  condition      Condition @default(VERY_GOOD)

  canSell        Boolean   @default(false)
  sellPrice      Float?
  buyBack        Boolean   @default(false)

  isArchived     Boolean   @default(false)
  archivedAt     DateTime?

  media          Media     @relation(fields: [mediaId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
  boxSet         BoxSet?   @relation(fields: [boxSetId], references: [id])
  tradeItems     TradeItem[]
}

model Trade {
  id                       Int          @id @default(autoincrement())
  buyerId                  Int
  sellerId                 Int
  type                     TradeType
  status                   TradeStatus  @default(REQUESTED)
  cancelledReason          String?
  sellerConfirmedTransfer  Boolean      @default(false)
  buyerConfirmedTransfer   Boolean      @default(false)
  returnRequested          Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  buyer                    User         @relation("TradeBuyer", fields: [buyerId], references: [id])
  seller                   User         @relation("TradeSeller", fields: [sellerId], references: [id])
  items                    TradeItem[]
  messages                 TradeMessage[]
}

model TradeItem {
  id         Int    @id @default(autoincrement())
  tradeId    Int
  copyId     Int
  agreedPrice Float

  trade      Trade @relation(fields: [tradeId], references: [id])
  copy       Copy  @relation(fields: [copyId], references: [id])

  @@unique([tradeId, copyId])
}

model TradeMessage {
  id         Int      @id @default(autoincrement())
  tradeId     Int
  senderId    Int
  message     String
  createdAt   DateTime @default(now())

  trade       Trade    @relation(fields: [tradeId], references: [id])
  sender      User     @relation(fields: [senderId], references: [id])
}

enum Edition {
  DVD
  BLURAY
  UHD_4K
  SOFT_COVER
  HARD_COVER
}

enum Condition {
  MINT
  VERY_GOOD
  GOOD
  FAIR
  POOR
}

enum Category {
  MOVIE
  TV_SHOW
  BOOK
  COMIC
}

enum TradeType {
  BUY
  RENT
}

enum TradeStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  RENTING
  COMPLETED
}